// Optional local overrides. Copy to Config/Secrets.xcconfig (gitignored).
// The Gemini key does NOT go here: it lives only on the server (backend/.env locally, or the host's env vars).

// Deployed server ("/$()/" keeps xcconfig from reading "//" as a comment):
// BUCKIT_API_URL = https:/$()/buckit-api.onrender.com
// BUCKIT_API_TOKEN = <BUCKIT_APP_TOKEN from the Render dashboard>
// CLOUDFORCE = NO
// FORCE_VERIFY = YES
