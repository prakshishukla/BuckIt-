// Shared build settings for BuckIt. Nothing here is secret: the Gemini key lives only on the
// BuckIt AI server (backend/.env). Local overrides go in Config/Secrets.xcconfig (gitignored).

// Base URL of the BuckIt AI API (backend/). Empty = offline demo mode.
// ("/$()/" keeps xcconfig from reading "//" as a comment.) On a real device, use your Mac's LAN IP.
BUCKIT_API_URL = http:/$()/127.0.0.1:8000
// Optional shared token; must match BUCKIT_APP_TOKEN in backend/.env.
BUCKIT_API_TOKEN =
// YES = always pass verification (stage safety net). NO = Gemini's verdict decides.
FORCE_VERIFY = NO

#include? "Secrets.xcconfig"
