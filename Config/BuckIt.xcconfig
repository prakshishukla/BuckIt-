// Shared build settings for BuckIt.
// Put your Gemini key in Config/Secrets.xcconfig (gitignored); copy Secrets.example.xcconfig to start.

// Empty = offline demo verifier.
GEMINI_API_KEY =
// Any Gemini vision-capable model id.
GEMINI_MODEL = gemini-3-flash-preview
// Cloudforce × DubHacks: YES = show the "Need more ideas?" link to our Side Kick on UW Purple.
// NO = remove every mention of UW Purple from the app.
CLOUDFORCE = YES
// YES = always pass verification (stage safety net). NO = Gemini's verdict decides.
FORCE_VERIFY = NO

#include? "Secrets.xcconfig"
