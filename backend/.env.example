# Copy to backend/.env (gitignored) and fill in. Never commit backend/.env.

# Required: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-3-flash-preview
# Photos must reach this confidence (0-1), on top of every criterion passing, to count as verified.
CONFIDENCE_THRESHOLD=0.7
# If set, the app must send this in the X-BuckIt-Token header (set BUCKIT_API_TOKEN in Config/Secrets.xcconfig).
BUCKIT_APP_TOKEN=
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=30
# Where the JSONL audit log goes.
AUDIT_LOG_PATH=logs/audit.jsonl
